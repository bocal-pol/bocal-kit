# ─── Credentials and auth tokens ──────────────────────────────────────────────
.credentials.json

# ─── Prompt/session history (personal data) ───────────────────────────────────
history.jsonl

# ─── Sessions and transcripts (personal data) ─────────────────────────────────
sessions/

# ─── Telemetry and session environment ────────────────────────────────────────
telemetry/
session-env/

# ─── Cache and runtime state ──────────────────────────────────────────────────
mcp-needs-auth-cache.json
policy-limits.json

# ─── Audit logs and shell snapshots ───────────────────────────────────────────
bash-audit.log
shell-snapshots/

# ─── Backups and file history ─────────────────────────────────────────────────
backups/
file-history/

# ─── Local settings (machine-specific) ────────────────────────────────────────
# Two distinct scopes: `settings.local.json` at the root overrides the user
# configuration (~/.claude), `.claude/settings.local.json` overrides the
# current project's. Both are machine-specific.
settings.local.json
.claude/settings.local.json

# ─── Local instructions (loaded by Claude Code if present) ───────────────────
CLAUDE.local.md

# ─── Ephemeral working files (unlazy gates, scratch) ──────────────────────────
.claude/tmp/

# ─── IDE locks and runtime state ──────────────────────────────────────────────
ide/

# ─── Local memory (outside the projects' auto-memory) ─────────────────────────
memory/

# ─── Work plans (ephemeral) ────────────────────────────────────────────────────
plans/

# ─── Plugins (local config, not transferable) ──────────────────────────────────
plugins/

# ─── Projects (sessions, transcripts, machine-specific data) ──────────────────
projects/

# ─── Node.js dependencies ──────────────────────────────────────────────────────
node_modules/
package-lock.json
package.json

# ─── Context files and temporary audits ────────────────────────────────────────
AUDIT_CLAUDE.md
remote-settings.json
.env

# ─── Logs and runtime caches (generated by hooks, never versioned) ────────────
logs/*.log
!logs/.gitkeep
cache/

# ─── Per-project knowledge (written by skills in <project>/.claude/, not here) ──
*-knowledge.md

# ─── Skills synced by the harness (claude.ai) ──────────────────────────────────
skills/synced/

# ─── Claude Code runtime state (locks, daemon, cleanup, temp files) ───────────
.claude.json
.last-cleanup
.update.lock
daemon/
policy-limits.json.stamp.json
policy-limits.json.stamp.json.tmp.*
policy-limits.json.signature.json
policy-limits.json.signature-iat.json
remote-settings.json.signature.json
remote-settings.json.signature-iat.json
remote-settings.json.synced-at
tmp/
state/

# ─── Skill trash (deletions via the harness, machine-specific) ───────────────
skills/.trash/
